<div class="card card-body p-4 rounded-0 bg-dark text-white">
<h4>Agregar el producto</h4>
<form action="/productos/agregar" method="post">
    <div>
        <label for="nombre">Escribe nombre:</label>
        <input type="text" name="nombre" placeholder="Name" id="nombre" required
        class="form-control bg-dark text-white"/>
    </div><br><br>
    <div>
       <label for="descripcion">Escribe descripción de producto: </label>
       <textarea name="descripcion" cols="25" rows="5" placeholder="Descripcion" required
       class="form-control bg-dark text-white"></textarea>
    </div><br><br>
    <div>
        <label for="precio">Escribe precio:</label>
        <input type="text" name="precio" placeholder="Price" id="precio" required
        class="form-control bg-dark text-white"/>
    </div><br><br>
    <button class="btn-success btn-sm mt-2">Agregar</button>
</form>
</div>
