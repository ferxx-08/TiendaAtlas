{{#if clientes}}
<table  class="table table-bordered table-hover table-dark">
    <thead>
        <tr class="text-center">
            <th>ID</th>
            <th>Nombre</th>
            <th>Apellido</th>
            <th>Correo</th>
            <th>Teléfono</th>
            <th>Dirección</th>
            <th>Edad</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        {{#each clientes}}
        <tr>
            <td>{{@index}}</td>
            <td>{{this.nombre}}</td>
            <td>{{this.apellido}}</td>
            <td>{{this.correo}}</td>
            <td>{{this.telefono}}</td>
            <td>{{this.direccion}}</td>
            <td>{{this.edad}}</td>
            <td class="text-center">
                <div class="d-flex justify-content-center gap-2">
                {{#if this.activo}}
                 <a href="/clientes/{{this._id}}/status" class="btn btn-success">Activo</a>
                {{else}}
                 <a href="/clientes/{{this._id}}/status" class="btn btn-warning ">Inactivo</a>
                {{/if}}
                 <a href="/clientes/{{this._id}}/update" class="btn btn-info ">Editar</a>
                 <a href="/clientes/{{this._id}}/delete" class="btn btn-danger">Eliminar</a>
                </div>
            </td>
        </tr>
        {{/each}}
    </tbody>
</table>
{{else}}
<p class="text-light">No hay clientes registrados.</p>
{{/if}}